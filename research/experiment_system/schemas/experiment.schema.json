{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdrnpp-rgbd/experiment.schema.json",
  "title": "GDRNPP-RGBD experiment identity",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "title",
    "stage",
    "status",
    "legacy_import",
    "protocol",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"pattern": "^EXP-[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "role": {"type": ["string", "null"]},
    "status": {
      "enum": ["PLANNED", "AUTHORIZED", "RUNNING", "COMPLETE", "FAILED", "TRIGGERED", "LEGACY"]
    },
    "legacy_import": {"type": "boolean"},
    "protocol": {"type": "object"},
    "evidence": {"type": "object"}
  },
  "additionalProperties": true
}
